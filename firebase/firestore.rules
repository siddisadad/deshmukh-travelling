rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper function to check if the data being written has the user's ID
    function isDataOwner() {
      return request.resource.data.userId == request.auth.uid;
    }

    // Helper function to check if the existing data belongs to the user
    function isExistingOwner() {
      return resource.data.userId == request.auth.uid;
    }

    // User profiles and loyalty points
    match /users/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // Wallet balance and transactions
    match /wallets/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // Bookings - both bus and hotel
    match /bookings/{bookingId} {
      allow create: if isAuthenticated() && isDataOwner();
      allow read, update, delete: if isAuthenticated() && isExistingOwner();
    }

    match /hotel_bookings/{bookingId} {
      allow create: if isAuthenticated() && isDataOwner();
      allow read, update, delete: if isAuthenticated() && isExistingOwner();
    }

    // Saved passengers for quick booking
    match /saved_passengers/{passengerId} {
      allow create: if isAuthenticated() && isDataOwner();
      allow read, update, delete: if isAuthenticated() && isExistingOwner();
    }

    // Public/Shared data (Read-only for users)
    match /buses/{busId} {
      allow read: if isAuthenticated();
    }

    match /bus_locations/{busId} {
      allow read: if isAuthenticated();
    }

    match /hotels/{hotelId} {
      allow read: if isAuthenticated();
    }

    match /rooms/{roomId} {
      allow read: if isAuthenticated();
    }

    match /packages/{packageId} {
      allow read: if isAuthenticated();
    }

    match /taxis/{taxiId} {
      allow read: if isAuthenticated();
    }
  }
}
